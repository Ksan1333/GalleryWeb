<Window x:Class="PixVault.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PixVault Native Preview" Width="1100" Height="800" MinWidth="620" MinHeight="420" Background="#181818" Foreground="#EEEEEE" PreviewKeyDown="OnKeyDown" AllowDrop="True" Drop="OnDrop">
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Background="#303030">
      <Button Content="開く…" Click="OnOpen" ToolTip="画像またはZIP/CBZを開く (Ctrl+O)"/>
      <Button Content="前のファイル" Click="OnPreviousFile"/>
      <Button Content="次のファイル" Click="OnNextFile"/>
      <CheckBox x:Name="SpreadOption" Content="見開き" Click="OnSettings"/>
      <CheckBox x:Name="BindingOption" Content="右綴じ" Click="OnSettings"/>
      <CheckBox x:Name="AppearanceOption" Content="NeeView風" Click="OnSettings"/>
    </WrapPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="10,6" Text="画像またはZIP/CBZを開いてください。通常ホイール：前後のファイル ／ Ctrl＋ホイール：拡大縮小"/>
    <Grid DockPanel.Dock="Bottom" Background="#303030">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="前ページ" Click="OnPreviousPage"/>
      <Button Grid.Column="1" Content="次ページ" Click="OnNextPage"/>
      <Slider x:Name="PageSlider" Grid.Column="2" Minimum="1" Maximum="1" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnPageSeek" ToolTip="ページ位置"/>
      <TextBlock x:Name="PageLabel" Grid.Column="3" VerticalAlignment="Center" Margin="8" Text="—"/>
      <Button x:Name="ZoomButton" Grid.Column="4" Content="100%" Click="OnResetZoom" ToolTip="画面に合わせる"/>
    </Grid>
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#161616" PreviewMouseWheel="OnWheel" SizeChanged="OnViewportSizeChanged">
      <StackPanel x:Name="Pages" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
        <StackPanel.LayoutTransform><ScaleTransform x:Name="ZoomTransform"/></StackPanel.LayoutTransform>
        <Image x:Name="LeftPage" Stretch="Uniform"/>
        <Image x:Name="RightPage" Stretch="Uniform"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
