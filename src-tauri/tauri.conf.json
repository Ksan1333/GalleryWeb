{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixVault for Windows",
  "version": "0.4.0",
  "identifier": "com.ninji.galleryweb",
  "build": {
    "beforeDevCommand": "npm run prepare:libvlc && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:libvlc && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixVault for Windows",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "bmp", "heic", "heif", "avif", "tif", "tiff"],
        "name": "PixVault.Image",
        "description": "PixVault image",
        "role": "Viewer"
      },
      {
        "ext": ["gif"],
        "name": "PixVault.GIF",
        "description": "PixVault GIF image",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "m4v", "mov", "mkv", "webm", "avi", "wmv", "mpeg", "mpg", "ts", "m2ts"],
        "name": "PixVault.Video",
        "description": "PixVault video",
        "role": "Viewer"
      },
      {
        "ext": ["zip", "cbz"],
        "name": "PixVault.BookArchive",
        "description": "PixVault ZIP or CBZ book",
        "role": "Viewer"
      },
      {
        "ext": ["pdf"],
        "name": "PixVault.PDF",
        "description": "PixVault PDF book",
        "role": "Viewer"
      }
    ],
    "resources": {
      "resources/THIRD_PARTY_AI_NOTICES.txt": "resources/THIRD_PARTY_AI_NOTICES.txt",
      "resources/THIRD_PARTY_NOTICES.txt": "resources/THIRD_PARTY_NOTICES.txt",
      "target/libvlc/vlc-3.0.23/": "vlc/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "startMenuFolder": "PixVault",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
