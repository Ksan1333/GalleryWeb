{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixVault for Windows",
  "version": "0.2.0",
  "identifier": "com.ninji.galleryweb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixVault for Windows",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "resources/THIRD_PARTY_AI_NOTICES.txt",
      "resources/THIRD_PARTY_NOTICES.txt"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "startMenuFolder": "PixVault"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
